# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://naas:naas@localhost:5435/naas?schema=public"

# HTTP port
PORT=3000

# Secret used to sign dashboard JWTs. Use a long random value in production.
JWT_SECRET="change-me-dashboard-secret-at-least-32-chars"
JWT_EXPIRES_IN="1d"

# Separate secret used to sign end-user (browser) tokens issued via /api/v1/user-tokens.
USER_TOKEN_SECRET="change-me-user-token-secret-at-least-32-chars"
USER_TOKEN_DEFAULT_TTL_SECONDS=3600

# Comma-separated list of allowed browser origins (dashboard + client apps).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Rate limiting: max requests per window per client.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300

# Stricter limit for /auth/register and /auth/login (per IP per minute)
AUTH_RATE_LIMIT_MAX=20
